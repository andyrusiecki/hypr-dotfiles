{
  "include": [
    "$DOTFILES_DIR/waybar/modules/all.jsonc"
  ],

  // General Settings
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 45,

  // Modules Left
  "modules-left": [
    "hyprland/workspaces",
    "custom/updates"
  ],

  // Modules Center
  "modules-center": [
    "custom/media"
  ],

  // Modules Right
  "modules-right": [
    "wireplumber",
    "clock",
    "tray",
    //"idle_inhibitor",
    "privacy",
    "custom/screen-recording",
    "bluetooth",
    "network",
    "cpu",
    "memory",
    "custom/dunst",
    "power-profiles-daemon",
    "battery",
    //"custom/brightness",
    //"custom/hypridle",
    "custom/exit"
  ]
}
