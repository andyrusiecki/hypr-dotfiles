{
  "include": [
    "$DOTFILES_DIR/waybar/modules/all.jsonc"
  ],

  // General Settings
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,

  // Modules Left
  "modules-left": [
    "hyprland/workspaces"
  ],

  // Modules Center
  "modules-center": [
    //"image#album-art",
    // "group/now-playing",
    "custom/media"
    // "mpris"
  ],

  // Modules Right
  "modules-right": [
    // "group/expand",
    "privacy",
    "custom/screen-recording",
    "custom/updates",
    "tray",
    "wireplumber",
    "bluetooth",
    "network",
    "custom/swaync",
    "battery",
    //"custom/auto-cpufreq",
    "clock"
  ],

  "group/expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "transition-to-left": true,
      "click-to-reveal": false
    },
    "modules": [
      "custom/expand",
      // "tray",
      "idle_inhibitor",
      //"custom/tailscale",
      "cpu",
      "memory"
      // "power-profiles-daemon",
      // "custom/exit"
    ]
  }
}
