{
  "custom/updates": {
    "format": " {}",
    "return-type": "json",
    "exec": "$DOTFILES_DIR/waybar/scripts/pending-updates-status.sh",
    "interval": 1200,
    "signal": 1,
    "hide-empty-text": true,
    "on-click": "uwsm-app -- kitty --class TUI.float /bin/bash -c \"$DOTFILES_DIR/hypr/scripts/system-update.sh\""
  }
}
