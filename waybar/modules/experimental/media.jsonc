{
  "group/media": {
    "orientation": "horizontal",
    "modules": [
      "custom/media-player",
      "group/media-track"
      //"custom/media-time"
    ]
  },
  "group/media-track": {
    "orientation": "vertical",
		"modules": [
			"custom/media-title",
      "custom/media-byline"
		]
  },
  "custom/media-player": {
    "exec": "$DOTFILES_DIR/waybar/scripts/playerctl-status.sh player",
    // "exec-if": "playerctl status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "default": " ",
      "chrome": "󰊯 ",
      "chromium": "󰊯 ",
      "firefox": " ",
      "spotify": " ",
      "twitch": " ",
      "youtube": " "
    },
    "interval": 1,
    "signal": 4,
    "on-scroll-up": "playerctld unshift; pkill -SIGRTMIN+4 waybar",
    "on-scroll-down": "playerctld shift; pkill -SIGRTMIN+4 waybar"
  },
  "custom/media-title": {
    "exec": "$DOTFILES_DIR/waybar/scripts/playerctl-status.sh title",
    "interval": 1,
    "justify": "left",
    "align": 0,
    "signal": 4,
    "on-scroll-up": "playerctld unshift; pkill -SIGRTMIN+4 waybar",
    "on-scroll-down": "playerctld shift; pkill -SIGRTMIN+4 waybar"
    // "exec-if": "playerctl status"
  },
  "custom/media-byline": {
    "exec": "$DOTFILES_DIR/waybar/scripts/playerctl-status.sh byline",
    "interval": 1,
    "justify": "left",
    "align": 0,
    "signal": 4,
    "on-scroll-up": "playerctld unshift; pkill -SIGRTMIN+4 waybar",
    "on-scroll-down": "playerctld shift; pkill -SIGRTMIN+4 waybar"
    // "exec-if": "playerctl status"
  },
  "custom/media-time": {
    "exec": "$DOTFILES_DIR/waybar/scripts/playerctl-status.sh time",
    "interval": 1,
    "signal": 4,
    "on-scroll-up": "playerctld unshift; pkill -SIGRTMIN+4 waybar",
    "on-scroll-down": "playerctld shift; pkill -SIGRTMIN+4 waybar"
    // "exec-if": "playerctl status"
  }
}
