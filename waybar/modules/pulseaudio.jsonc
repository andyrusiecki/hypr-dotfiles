{
  "pulseaudio": {
    "scroll-step": 1,
    "format": "{icon} {volume}%",
    "on-click": "uwsm-app -- kitty --class waybar.float wiremix",
    "tooltip-format": "Playing at {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        " "
      ]
    }
  }
}
