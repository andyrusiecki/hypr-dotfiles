include=~/.config/hypr/theme/mako-colors.ini

anchor=top-right
default-timeout=10000
max-history=20
width=420
height=110

padding=10
border-size=2
border-radius=0
font=Hack Nerd Font 12
max-icon-size=64
outer-margin=20

icon-path=/var/lib/flatpak/exports/share/icons/hicolor

[mode=do-not-disturb]
invisible=true

[mode=do-not-disturb app-name=notify-send]
invisible=false

[urgency=critical]
default-timeout=0

# audio
[app-name=audio]
layer=overlay
history=0
anchor=top-center
# Group all volume notifications together
group-by=app-name
# Hide the group-index
format=<b>%s</b>\n%b

[app-name=audio group-index=0]
# Only show last notification
invisible=0

[app-name=audio grouped=false]
# Force initial volume notification to be visible
invisible=0

# backlight
[app-name=backlight]
layer=overlay
history=0
anchor=top-center
# Group all backlight notifications together
group-by=app-name
# Hide the group-index
format=<b>%s</b>\n%b

[app-name=backlight group-index=0]
# Only show last notification
invisible=0

[app-name=backlight grouped=false]
# Force initial backlight notification to be visible
invisible=0

